{
  "productName": "最后的自由",
  "version": "3.0.0",
  "identifier": "com.chasegame.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "争取最后的自由",
        "width": 1366,
        "height": 768,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "packageName": "last-freedom"
      }
    }
  }
}
